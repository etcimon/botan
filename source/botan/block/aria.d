/**
* ARIA-128
*/
final class ARIA128 : BlockCipherFixedParams!(16, 16), BlockCipher, SymmetricAlgorithm
{
public:
    override void encryptN(const(ubyte)* input, ubyte* output, size_t blocks)
    { ariaMaybeHwaes(input, output, blocks, m_ERK); }
    override void decryptN(const(ubyte)* input, ubyte* output, size_t blocks)
    { ariaMaybeHwaes(input, output, blocks, m_DRK); }
    override void clear() { zap(m_ERK); zap(m_DRK); }
    @property string name() const { return "ARIA-128"; }
    override @property size_t parallelism() const { return ariaHwaesParallelism(); }
    package ref const(SecureVector!uint) erk() const { return m_ERK; }
    package ref const(SecureVector!uint) drk() const { return m_DRK; }
    override BlockCipher clone() const { return new ARIA128; }
    override size_t blockSize() const { return super.blockSize(); }
    override KeyLengthSpecification keySpec() const { return super.keySpec(); }
protected:
    override void keySchedule(const(ubyte)* key, size_t length)
    { ariaKeySchedule(m_ERK, m_DRK, key, length); }
    SecureVector!uint m_ERK, m_DRK;
}

