enum uint M1 = 0x00010101;
enum uint M2 = 0x01000101;
enum uint M3 = 0x01010001;
enum uint M4 = 0x01010100;

uint ariaF1(uint X)
{
    return (S1[get_byte(0, X)] * M1) ^ (S2[get_byte(1, X)] * M2)
         ^ (X1[get_byte(2, X)] * M3) ^ (X2[get_byte(3, X)] * M4);
}

uint ariaF2(uint X)
{
    return (X1[get_byte(0, X)] * M3) ^ (X2[get_byte(1, X)] * M4)
         ^ (S1[get_byte(2, X)] * M1) ^ (S2[get_byte(3, X)] * M2);
}

void ariaFO(ref uint T0, ref uint T1, ref uint T2, ref uint T3)
{
    T0 = ariaF1(T0); T1 = ariaF1(T1); T2 = ariaF1(T2); T3 = ariaF1(T3);
    T1 ^= T2; T2 ^= T3; T0 ^= T1; T3 ^= T1; T2 ^= T0; T1 ^= T2;
    T1 = ((T1 << 8) & 0xFF00FF00) | ((T1 >> 8) & 0x00FF00FF);
    T2 = rotateRight(T2, 16);
    T3 = reverseBytes(T3);
    T1 ^= T2; T2 ^= T3; T0 ^= T1; T3 ^= T1; T2 ^= T0; T1 ^= T2;
}

void ariaFE(ref uint T0, ref uint T1, ref uint T2, ref uint T3)
{
    T0 = ariaF2(T0); T1 = ariaF2(T1); T2 = ariaF2(T2); T3 = ariaF2(T3);
    T1 ^= T2; T2 ^= T3; T0 ^= T1; T3 ^= T1; T2 ^= T0; T1 ^= T2;
    T3 = ((T3 << 8) & 0xFF00FF00) | ((T3 >> 8) & 0x00FF00FF);
    T0 = rotateRight(T0, 16);
    T1 = reverseBytes(T1);
    T1 ^= T2; T2 ^= T3; T0 ^= T1; T3 ^= T1; T2 ^= T0; T1 ^= T2;
}

void ariaRol128(size_t N)(const uint[4] X, const uint[4] Y, uint* KS)
{
    enum size_t Q = 4 - (N / 32);
    enum size_t R = N % 32;
    KS[0] = X[0] ^ (Y[(Q) % 4] >> R) ^ (Y[(Q + 3) % 4] << (32 - R));
    KS[1] = X[1] ^ (Y[(Q + 1) % 4] >> R) ^ (Y[(Q) % 4] << (32 - R));
    KS[2] = X[2] ^ (Y[(Q + 2) % 4] >> R) ^ (Y[(Q + 1) % 4] << (32 - R));
    KS[3] = X[3] ^ (Y[(Q + 3) % 4] >> R) ^ (Y[(Q + 2) % 4] << (32 - R));
}

void ariaKsDkTransform(ref uint K0, ref uint K1, ref uint K2, ref uint K3)
{
    K0 = rotateRight(K0, 8) ^ rotateRight(K0, 16) ^ rotateRight(K0, 24);
    K1 = rotateRight(K1, 8) ^ rotateRight(K1, 16) ^ rotateRight(K1, 24);
    K2 = rotateRight(K2, 8) ^ rotateRight(K2, 16) ^ rotateRight(K2, 24);
    K3 = rotateRight(K3, 8) ^ rotateRight(K3, 16) ^ rotateRight(K3, 24);
    K1 ^= K2; K2 ^= K3; K0 ^= K1; K3 ^= K1; K2 ^= K0; K1 ^= K2;
    K1 = ((K1 << 8) & 0xFF00FF00) | ((K1 >> 8) & 0x00FF00FF);
    K2 = rotateRight(K2, 16);
    K3 = reverseBytes(K3);
    K1 ^= K2; K2 ^= K3; K0 ^= K1; K3 ^= K1; K2 ^= K0; K1 ^= K2;
}

size_t ariaHwaesParallelism()
{
    static if (BOTAN_HAS_ARIA_HWAES)
        return 4;
    else
        return 1;
}

void ariaMaybeHwaes(const(ubyte)* inn, ubyte* outp, size_t blocks, const ref SecureVector!uint KS)
{
    static if (BOTAN_HAS_ARIA_HWAES)
    {
        if (CPUID.hasAesNi() && CPUID.hasSsse3())
        {
            ariaHwaesTransform(inn, outp, blocks, KS.ptr, KS.length);
            return;
        }
    }
    ariaTransform(inn, outp, blocks, KS);
}

package void ariaTransform(const(ubyte)* inn, ubyte* outp, size_t blocks, const ref SecureVector!uint KS)
{
    const size_t rounds = (KS.length / 4) - 1;
    foreach (i; 0 .. blocks)
    {
        uint t0 = loadBigEndian!uint(inn + 16 * i, 0);
        uint t1 = loadBigEndian!uint(inn + 16 * i, 1);
        uint t2 = loadBigEndian!uint(inn + 16 * i, 2);
        uint t3 = loadBigEndian!uint(inn + 16 * i, 3);
        for (size_t r = 0; r < rounds; r += 2)
        {
            t0 ^= KS[4 * r];
            t1 ^= KS[4 * r + 1];
            t2 ^= KS[4 * r + 2];
            t3 ^= KS[4 * r + 3];
            ariaFO(t0, t1, t2, t3);
            t0 ^= KS[4 * r + 4];
            t1 ^= KS[4 * r + 5];
            t2 ^= KS[4 * r + 6];
            t3 ^= KS[4 * r + 7];
            if (r != rounds - 2)
                ariaFE(t0, t1, t2, t3);
        }
        const size_t b = 16 * i;
        outp[b + 0] = cast(ubyte)(X1[get_byte(0, t0)] ^ get_byte(0, KS[4 * rounds]));
        outp[b + 1] = cast(ubyte)(X2[get_byte(1, t0)] ^ get_byte(1, KS[4 * rounds]));
        outp[b + 2] = cast(ubyte)(S1[get_byte(2, t0)] ^ get_byte(2, KS[4 * rounds]));
        outp[b + 3] = cast(ubyte)(S2[get_byte(3, t0)] ^ get_byte(3, KS[4 * rounds]));
        outp[b + 4] = cast(ubyte)(X1[get_byte(0, t1)] ^ get_byte(0, KS[4 * rounds + 1]));
        outp[b + 5] = cast(ubyte)(X2[get_byte(1, t1)] ^ get_byte(1, KS[4 * rounds + 1]));
        outp[b + 6] = cast(ubyte)(S1[get_byte(2, t1)] ^ get_byte(2, KS[4 * rounds + 1]));
        outp[b + 7] = cast(ubyte)(S2[get_byte(3, t1)] ^ get_byte(3, KS[4 * rounds + 1]));
        outp[b + 8] = cast(ubyte)(X1[get_byte(0, t2)] ^ get_byte(0, KS[4 * rounds + 2]));
        outp[b + 9] = cast(ubyte)(X2[get_byte(1, t2)] ^ get_byte(1, KS[4 * rounds + 2]));
        outp[b + 10] = cast(ubyte)(S1[get_byte(2, t2)] ^ get_byte(2, KS[4 * rounds + 2]));
        outp[b + 11] = cast(ubyte)(S2[get_byte(3, t2)] ^ get_byte(3, KS[4 * rounds + 2]));
        outp[b + 12] = cast(ubyte)(X1[get_byte(0, t3)] ^ get_byte(0, KS[4 * rounds + 3]));
        outp[b + 13] = cast(ubyte)(X2[get_byte(1, t3)] ^ get_byte(1, KS[4 * rounds + 3]));
        outp[b + 14] = cast(ubyte)(S1[get_byte(2, t3)] ^ get_byte(2, KS[4 * rounds + 3]));
        outp[b + 15] = cast(ubyte)(S2[get_byte(3, t3)] ^ get_byte(3, KS[4 * rounds + 3]));
    }
}

void ariaKeySchedule(ref SecureVector!uint ERK, ref SecureVector!uint DRK,
                     const(ubyte)* key, size_t length)
{
    static immutable uint[4][3] KRK = [
        [0x517cc1b7, 0x27220a94, 0xfe13abe8, 0xfa9a6ee0],
        [0x6db14acc, 0x9e21c820, 0xff28b1d5, 0xef5de2b0],
        [0xdb92371d, 0x2126e970, 0x03249775, 0x04e8c90e]
    ];
    const size_t CK0 = (length / 8) - 2;
    const size_t CK1 = (CK0 + 1) % 3;
    const size_t CK2 = (CK1 + 1) % 3;

    uint[4] w0, w1, w2, w3;
    w0[0] = loadBigEndian!uint(key, 0);
    w0[1] = loadBigEndian!uint(key, 1);
    w0[2] = loadBigEndian!uint(key, 2);
    w0[3] = loadBigEndian!uint(key, 3);
    w1[0] = w0[0] ^ KRK[CK0][0];
    w1[1] = w0[1] ^ KRK[CK0][1];
    w1[2] = w0[2] ^ KRK[CK0][2];
    w1[3] = w0[3] ^ KRK[CK0][3];
    ariaFO(w1[0], w1[1], w1[2], w1[3]);
    if (length == 24 || length == 32)
    {
        w1[0] ^= loadBigEndian!uint(key, 4);
        w1[1] ^= loadBigEndian!uint(key, 5);
    }
    if (length == 32)
    {
        w1[2] ^= loadBigEndian!uint(key, 6);
        w1[3] ^= loadBigEndian!uint(key, 7);
    }
    w2[0] = w1[0] ^ KRK[CK1][0];
    w2[1] = w1[1] ^ KRK[CK1][1];
    w2[2] = w1[2] ^ KRK[CK1][2];
    w2[3] = w1[3] ^ KRK[CK1][3];
    ariaFE(w2[0], w2[1], w2[2], w2[3]);
    w2[0] ^= w0[0]; w2[1] ^= w0[1]; w2[2] ^= w0[2]; w2[3] ^= w0[3];
    w3[0] = w2[0] ^ KRK[CK2][0];
    w3[1] = w2[1] ^ KRK[CK2][1];
    w3[2] = w2[2] ^ KRK[CK2][2];
    w3[3] = w2[3] ^ KRK[CK2][3];
    ariaFO(w3[0], w3[1], w3[2], w3[3]);
    w3[0] ^= w1[0]; w3[1] ^= w1[1]; w3[2] ^= w1[2]; w3[3] ^= w1[3];

    if (length == 16)
        ERK.resize(4 * 13);
    else if (length == 24)
        ERK.resize(4 * 15);
    else
        ERK.resize(4 * 17);

    ariaRol128!19(w0, w1, &ERK[0]);
    ariaRol128!19(w1, w2, &ERK[4]);
    ariaRol128!19(w2, w3, &ERK[8]);
    ariaRol128!19(w3, w0, &ERK[12]);
    ariaRol128!31(w0, w1, &ERK[16]);
    ariaRol128!31(w1, w2, &ERK[20]);
    ariaRol128!31(w2, w3, &ERK[24]);
    ariaRol128!31(w3, w0, &ERK[28]);
    ariaRol128!67(w0, w1, &ERK[32]);
    ariaRol128!67(w1, w2, &ERK[36]);
    ariaRol128!67(w2, w3, &ERK[40]);
    ariaRol128!67(w3, w0, &ERK[44]);
    ariaRol128!97(w0, w1, &ERK[48]);
    if (length == 24 || length == 32)
    {
        ariaRol128!97(w1, w2, &ERK[52]);
        ariaRol128!97(w2, w3, &ERK[56]);
        if (length == 32)
        {
            ariaRol128!97(w3, w0, &ERK[60]);
            ariaRol128!109(w0, w1, &ERK[64]);
        }
    }

    DRK.resize(ERK.length);
    for (size_t i = 0; i != DRK.length; i += 4)
    {
        DRK[i]     = ERK[ERK.length - 4 - i];
        DRK[i + 1] = ERK[ERK.length - 3 - i];
        DRK[i + 2] = ERK[ERK.length - 2 - i];
        DRK[i + 3] = ERK[ERK.length - 1 - i];
    }
    for (size_t i = 4; i != DRK.length - 4; i += 4)
        ariaKsDkTransform(DRK[i], DRK[i + 1], DRK[i + 2], DRK[i + 3]);
}
